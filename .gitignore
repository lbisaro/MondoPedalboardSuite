# ── Python ─────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
*.egg

# ── Entorno virtual ─────────────────────────────────────────────────────────
.venv/
venv/
env/

# ── Build PyInstaller (carpetas temporales) ─────────────────────────────────
build/
dist/
*.spec.bak

# ── Datos de usuario (settings, presets, DI, etc.) ─────────────────────────
user_data/

# ── Instalador (no distribuir por Git) ──────────────────────────────────────
installer_output/

# ── IDEs ────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── OS ──────────────────────────────────────────────────────────────────────
Thumbs.db
desktop.ini
.DS_Store

# ── Lo que SI se publica ────────────────────────────────────────────────────
# Fuentes Python
!*.py

# Scripts de build y configuracion
!build.ps1
!build.bat
!MondoPBSuite.spec
!installer.iss

# Ejecutable generado (en la raiz del proyecto)
!MondoPBSuite.exe

# Control de version
!version.json

# Docs y README
!README.md
!docs/
!docs/**

# Dependencias declaradas
!requirements.txt
